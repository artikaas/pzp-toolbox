{% import '_components/macros.twig' as m %}
<article class="stap" id="stap-{{ stap.nummer }}" aria-labelledby="stap-{{ stap.nummer }}-titel">
  <div class="stap__hoofd">
    <h2 class="stap__titel" id="stap-{{ stap.nummer }}-titel">{{ m.tag(stap.nummer, true) }}<span class="sr-only">Stap {{ stap.nummer }}: </span>{{ stap.titel }}</h2>
    <div class="stap__kolommen">
      {% for kolom in stap.kolommen %}
      <div class="stap__kolom">
        {% for groep in kolom %}
        <div class="groep">
          <h3 class="groep__kop">{{ groep.kop }}</h3>
          {% if groep.tekst is defined and groep.tekst %}<p>{{ groep.tekst|raw }}</p>{% endif %}
          {% if groep.items is defined and groep.items|length %}<ul class="lijst">{% for item in groep.items %}<li>{{ item|raw }}</li>{% endfor %}</ul>{% endif %}
        </div>
        {% endfor %}
      </div>
      {% endfor %}
    </div>
    <div class="stap__knoppen">
      <button class="knop group transition-[background-color,translate,box-shadow] duration-300 ease-veer hover:-translate-y-0.5 hover:shadow-[0_10px_20px_-10px_rgb(111_13_59/.45)] active:translate-y-0" type="button" data-open="meer-{{ stap.nummer }}" aria-haspopup="dialog">{{ globals.leesMeer }}<span class="sr-only"> over stap {{ stap.nummer }}</span> {{ m.pijl() }}</button>
    </div>
  </div>
  <aside class="stap__zij" aria-label="Tips bij stap {{ stap.nummer }}">
    <a class="knop-vierkant transition-[background-color,translate] duration-300 ease-veer hover:-translate-y-0.5" href="#cirkel" aria-label="Terug naar het overzicht"><img src="assets/icoon-home.svg" width="24" height="24" alt=""></a>
    <div class="tips">
      <p class="tips__kop">{{ globals.tipsKop }}</p>
      {% for tip in stap.tips %}<p>{{ tip|raw }}</p>{% endfor %}
    </div>
    <ul class="legenda" aria-label="Wie is betrokken">
      {% for rol in stap.rollen %}<li>{{ m.rolicoon(globals.rollen[rol].kleur) }}{{ globals.rollen[rol].label }}</li>{% endfor %}
    </ul>
    <button class="toolbox group" type="button" data-open="meer-{{ stap.nummer }}" data-tab="hulpmiddelen" aria-haspopup="dialog">
      <svg class="toolbox__svg transition-[translate,rotate] duration-500 ease-veer group-hover:-translate-y-1.5 group-hover:-rotate-3 group-focus-visible:-translate-y-1.5 group-focus-visible:-rotate-3" viewBox="0 0 628 424" width="170" height="115" aria-hidden="true" focusable="false"><use href="#gereedschapskist"/></svg>
      <span class="toolbox__label">{{ globals.toolboxLabel }}</span>
      <span class="sr-only">: {{ globals.tabHulpmiddelen|lower }} bij stap {{ stap.nummer }}</span>
    </button>
  </aside>
</article>

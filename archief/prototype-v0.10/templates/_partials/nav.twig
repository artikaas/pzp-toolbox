<header class="nav sticky top-0 z-40 transition-shadow duration-300 ease-zacht data-[gescrold]:shadow-[0_10px_30px_-14px_rgb(0_0_0/.45)]">
  <a class="logo" href="#cirkel" aria-label="{{ globals.toolnaam|join(' ') }}, naar het begin">
    <span class="logo__boven">{{ globals.toolnaam[0] }}</span><span class="logo__onder">{{ globals.toolnaam[1] }}</span>
  </a>
  <button class="menuknop transition-[background-color,translate] duration-300 ease-veer hover:-translate-y-0.5 active:translate-y-0" type="button" data-open="menu" aria-haspopup="dialog">
    <span>{{ globals.menuLabel }}</span>
    <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true"><path d="M1 1.5h20M1 8h20M1 14.5h20" stroke="#6F0D3B" stroke-width="2.5" stroke-linecap="round"/></svg>
  </button>
</header>

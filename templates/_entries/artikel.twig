{#-
  Artikelen (sectie Artikelen): header met datum en de blokken in artikelopmaak.
  Het kruimelpad verwijst naar de pagina met slug 'artikelen' (het overzicht), als die bestaat.
-#}
{%- extends '_layouts/base' -%}
{%- import '_components/macros' as m -%}
{%- set overzicht = craft.entries().section('paginas').slug('artikelen').one() -%}
{%- set crumbs = overzicht ? [{ label: overzicht.title, url: overzicht.url }] : [] -%}
{%- set crumbs = crumbs|merge([{ label: entry.title }]) -%}
{%- block content -%}
  {% include '_components/hero' with { entry: entry, crumbs: crumbs, meta: m.datum(entry.postDate)|trim } only %}
  {%- set blokken = entry.blokken.all() %}
  {%- if blokken is not empty %}
    <div class="blokken blokken--artikel">
      {% include '_blokken/_render' with { blokken: blokken, entry: entry, context: 'artikel' } only %}
    </div>
  {%- endif %}
{%- endblock -%}

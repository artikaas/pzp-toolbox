{#- Pagina's (sectie Pagina's): header met kruimelpad en de blokken. -#}
{%- extends '_layouts/base' -%}
{%- set crumbs = [] -%}
{%- for a in entry.ancestors.all() -%}
  {%- set crumbs = crumbs|merge([{ label: (a.kruimelLabel ?? null) ?: a.title, url: a.url }]) -%}
{%- endfor -%}
{%- set crumbs = crumbs|merge([{ label: (entry.kruimelLabel ?? null) ?: entry.title }]) -%}
{%- block content -%}
  {% include '_components/hero' with { entry: entry, crumbs: crumbs } only %}
  {%- set blokken = entry.blokken.all() %}
  {%- if blokken is not empty %}
    <div class="blokken blokken--pagina">
      {% include '_blokken/_render' with { blokken: blokken, entry: entry, context: 'pagina' } only %}
    </div>
  {%- endif %}
{%- endblock -%}

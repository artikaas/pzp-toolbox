{#-
  Basislayout. Variabelen die een entrytemplate vóór {% extends %} kan zetten:
  - paginaTitel   titel in het tabblad (standaard SEO-titel of titel van de entry)
  - omschrijving  meta description
  - noindex       true = niet indexeren
-#}
{%- set entry = entry ?? null -%}
{%- set siteTitel = (algemeen.siteTitel ?? null) ?: siteName -%}
{%- set paginaTitel = paginaTitel ?? (entry and entry.section.handle != 'home' ? ((entry.seoTitel ?? null) ?: entry.title) : null) -%}
{%- set fullTitle = paginaTitel ? paginaTitel ~ ' | ' ~ siteTitel : siteTitel -%}
{%- set omschrijving = omschrijving ?? (entry ? ((entry.seoOmschrijving ?? null) ?: (entry.samenvatting ?? null)) : null) ?: (algemeen.seoOmschrijving ?? '') -%}
{%- set deelbeeld = entry ? (entry.heroAfbeelding.one() ?? null) : null -%}
{%- set deelbeeld = deelbeeld ?? (algemeen.deelbeeld.one() ?? null) -%}
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ fullTitle }}</title>
  {%- if omschrijving %}<meta name="description" content="{{ omschrijving }}">{% endif %}
  <link rel="canonical" href="{{ craft.app.request.absoluteUrl|split('?')|first }}">
  {%- if (noindex ?? false) or prototype %}<meta name="robots" content="noindex">{% endif %}
  <meta property="og:title" content="{{ fullTitle }}">
  {%- if omschrijving %}<meta property="og:description" content="{{ omschrijving }}">{% endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="nl_NL">
  {%- if deelbeeld %}<meta property="og:image" content="{{ deelbeeld.getUrl({ width: 1200, height: 630, mode: 'crop', format: 'jpg' }) }}">{% endif %}
  {#- Gelijk aan --color-primair in src/css/app.css -#}
  <meta name="theme-color" content="#1f2b4d">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {#- Preload het belangrijkste webfont, bijv.: <link rel="preload" href="/fonts/merkfont-regular.woff2" as="font" type="font/woff2" crossorigin> -#}
  {{ vite('src/js/app.js') }}
</head>
<body class="flex min-h-svh flex-col">
  <a href="#main" class="sr-only z-[60] rounded bg-wit px-4 py-2 text-primair focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Naar de inhoud</a>
  {% include '_partials/header' %}
  <main id="main" class="flex-1">
    {%- block content %}{% endblock %}
  </main>
  {% include '_partials/footer' %}
</body>
</html>

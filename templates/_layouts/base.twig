{#-
  Basislayout (De Bron, aangepast voor de toolbox). Variabelen die een entrytemplate vóór {% extends %} kan zetten:
  - paginaTitel   titel in het tabblad (standaard alleen de sitetitel)
  - omschrijving  meta description
  - noindex       true = niet indexeren
-#}
{%- set entry = entry ?? null -%}
{%- set siteTitel = (algemeen.siteTitel ?? null) ?: siteName -%}
{%- set paginaTitel = paginaTitel ?? (entry ? (entry.seoTitel ?? null) : null) -%}
{%- set fullTitle = paginaTitel ? paginaTitel ~ ' | ' ~ siteTitel : siteTitel -%}
{%- set omschrijving = omschrijving ?? (entry ? (entry.seoOmschrijving ?? null) : null) ?: (algemeen.seoOmschrijving ?? '') -%}
{%- set deelbeeld = algemeen.deelbeeld.one() ?? null -%}
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ fullTitle }}</title>
  {%- if omschrijving %}<meta name="description" content="{{ omschrijving }}">{% endif %}
  <link rel="canonical" href="{{ craft.app.request.absoluteUrl|split('?')|first }}">
  {%- if (noindex ?? false) or prototype %}<meta name="robots" content="noindex">{% endif %}
  <meta property="og:title" content="{{ fullTitle }}">
  {%- if omschrijving %}<meta property="og:description" content="{{ omschrijving }}">{% endif %}
  <meta property="og:type" content="website">
  <meta property="og:locale" content="nl_NL">
  {%- if deelbeeld %}<meta property="og:image" content="{{ deelbeeld.getUrl({ width: 1200, height: 630, mode: 'crop', format: 'jpg' }) }}">{% endif %}
  <meta name="theme-color" content="#6f0d3b">
  <link rel="icon" href="{{ url('favicon.svg') }}" type="image/svg+xml">
  <link rel="preload" href="/fonts/railroad-gothic-atf-black.woff2" as="font" type="font/woff2" crossorigin>
  {{ vite('src/js/app.js') }}
</head>
<body>
  <a class="skiplink" href="#inhoud">Naar de inhoud</a>
  {% include '_svg/gereedschapskist-symbol.svg' %}
  {% include '_partials/header' %}
  <main id="inhoud">
    {%- block content %}{% endblock %}
  </main>
  {% include '_partials/footer' %}
  {%- block overlays %}{% endblock %}
</body>
</html>

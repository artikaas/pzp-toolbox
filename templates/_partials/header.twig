{#- Navbar: logo (twee delen uit de global Toolbox) en de menuknop. Scrollt mee. -#}
{%- set naam = [toolboxAlgemeen.naamDeel1 ?? '', toolboxAlgemeen.naamDeel2 ?? '']|filter -%}
<header class="nav sticky top-0 z-40 transition-shadow duration-300 ease-zacht data-[gescrold]:shadow-[0_10px_30px_-14px_rgb(0_0_0/.45)]">
  <a class="logo" href="#cirkel" aria-label="{{ naam|join(' ') }}, naar het begin">
    {%- for deel in naam %}<span class="{{ loop.first ? 'logo__boven' : 'logo__onder' }}">{{ deel }}</span>{% endfor -%}
  </a>
  <button class="menuknop transition-[background-color,translate] duration-300 ease-veer hover:-translate-y-0.5 active:translate-y-0" type="button" data-open="menu" aria-haspopup="dialog">
    <span>{{ labels.menuLabel }}</span>
    {% include '_components/icons/menu' with { class: 'size-6' } only %}
  </button>
</header>

{#- Footer: logo en regel onderaan (global Footer). -#}
{%- set logo = footer.logo.one() ?? null -%}
<footer class="footer">
  <div class="footer__vlak">
    {%- if logo %}<img src="{{ logo.url }}" width="204" height="109" alt="{{ logo.alt ?: 'Zelf zorgen, samen doen' }}">{% endif %}
    {%- if footer.onderschrift %}<p class="footer__tekst">{{ footer.onderschrift }}</p>{% endif %}
  </div>
</footer>

{#-
  Call-to-action: kop, korte tekst en een knop. Gebruikt door het blok 'cta' en de footer.
  - kop, tekst, link, id
  - achtergrond  'primair' (standaard), 'vlak' of 'wit' (dan een kaart met rand)
-#}
{%- import '_components/macros' as m -%}
{%- set achtergrond = achtergrond ?? 'primair' -%}
{%- set donker = achtergrond == 'primair' -%}
{%- set id = id ?? ('cta-' ~ random()) -%}
<section class="{{ { primair: 'op-donker bg-primair text-wit', vlak: 'bg-vlak' }[achtergrond] ?? '' }} {{ achtergrond != 'wit' ? 'py-16 md:py-20' }}" aria-labelledby="{{ id }}">
  <div class="container-site">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between md:gap-12 {{ achtergrond == 'wit' ? 'rounded-kaart border border-rand p-8 md:p-12' }}" data-reveal>
      <div class="max-w-2xl">
        <h2 id="{{ id }}" class="text-h2 {{ donker ? '' : 'text-primair' }}">{{ m.accent(kop) }}</h2>
        {%- if tekst ?? null %}<p class="mt-4 text-lead {{ donker ? 'text-wit/85' : 'text-tekst-zacht' }}">{{ tekst|nl2br }}</p>{% endif %}
      </div>
      {%- if (link ?? null) and link.url %}<div class="shrink-0">{% include '_components/link' with { link: link } only %}</div>{% endif %}
    </div>
  </div>
</section>

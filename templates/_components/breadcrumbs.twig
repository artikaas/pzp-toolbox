{#-
  Kruimelpad.
  - items  lijst van { label, url } (laatste = huidige pagina, zonder url)
  - class  bijv. kleur: 'text-wit/80'
-#}
{%- set trail = [{ label: 'Home', url: siteUrl }]|merge(items ?? []) -%}
<nav aria-label="Kruimelpad" class="{{ class ?? 'text-tekst-zacht' }}">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-klein">
    {%- for c in trail %}
      <li class="flex items-center gap-2">
        {%- if (c.url ?? false) and not loop.last -%}
          <a href="{{ c.url }}" class="underline-offset-2 hover:underline">{{ c.label }}</a>
        {%- else -%}
          <span aria-current="page">{{ c.label }}</span>
        {%- endif -%}
        {%- if not loop.last %}{% include '_components/icons/chevron-rechts' with { class: 'size-3 opacity-60' } only %}{% endif -%}
      </li>
    {%- endfor %}
  </ol>
</nav>

{#- Afbeelding in de breedte van de site (in artikelen iets smaller), met onderschrift en bron. -#}
{%- set beeld = blok.afbeelding.one() -%}
<figure class="{{ context == 'artikel' ? 'mx-auto w-full max-w-[64rem] px-4 md:px-6' : 'container-site' }}" data-reveal>
  <div class="relative overflow-hidden rounded-kaart bg-vlak" style="aspect-ratio: {{ beeld and beeld.width and beeld.height ? beeld.width ~ '/' ~ beeld.height : '16/9' }}">
    {% include '_components/image' with { image: beeld, sizes: '(min-width: 1280px) 1280px, 100vw', widths: [640, 1024, 1440, 1920, 2560] } only %}
  </div>
  {%- if blok.onderschrift or blok.bronvermelding %}
    <figcaption class="mt-3 flex flex-col gap-1 text-klein text-tekst-zacht md:flex-row md:justify-between md:gap-6">
      {%- if blok.onderschrift %}<span>{{ blok.onderschrift }}</span>{% endif %}
      {%- if blok.bronvermelding %}<span class="md:ml-auto">{{ blok.bronvermelding }}</span>{% endif %}
    </figcaption>
  {%- endif %}
</figure>

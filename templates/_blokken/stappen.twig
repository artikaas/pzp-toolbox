{#- Genummerde stappen met optioneel beeld. -#}
{%- import '_components/macros' as m -%}
{%- set stappen = blok.stappenItems.all() -%}
<section class="container-site" {% if blok.kop %}aria-labelledby="blok-{{ blok.id }}"{% endif %}>
  {%- if blok.kop %}<h2 id="blok-{{ blok.id }}" class="mb-10 max-w-3xl text-h2 text-primair" data-reveal>{{ m.accent(blok.kop) }}</h2>{% endif %}
  <ol class="grid gap-8 sm:grid-cols-2 {{ stappen|length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3' }}">
    {%- for stap in stappen %}
      <li class="flex flex-col gap-4" data-reveal>
        {%- set beeld = stap.afbeelding.one() %}
        {%- if beeld %}<div class="relative aspect-[4/3] overflow-hidden rounded-kaart bg-vlak">{% include '_components/image' with { image: beeld, sizes: '(min-width: 1024px) 25vw, 50vw', widths: [400, 640, 800] } only %}</div>{% endif %}
        <span class="inline-flex size-10 items-center justify-center rounded-full bg-accent font-bold text-primair-donker" aria-hidden="true">{{ loop.index }}</span>
        <h3 class="text-h3 text-primair"><span class="sr-only">Stap {{ loop.index }}: </span>{{ stap.title }}</h3>
        {%- if stap.tekstPlat %}<p class="text-tekst-zacht">{{ stap.tekstPlat|nl2br }}</p>{% endif %}
      </li>
    {%- endfor %}
  </ol>
</section>

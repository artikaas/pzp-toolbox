{#- Accordeon (bijv. veelgestelde vragen) met native <details>: werkt zonder JavaScript en met toetsenbord. -#}
{%- import '_components/macros' as m -%}
<section class="accordeon container-tekst" {% if blok.kop %}aria-labelledby="blok-{{ blok.id }}"{% endif %} data-reveal>
  {%- if blok.kop %}<h2 id="blok-{{ blok.id }}" class="text-h2 text-primair">{{ m.accent(blok.kop) }}</h2>{% endif %}
  {%- if blok.intro %}<p class="mt-4 text-lead text-tekst-zacht">{{ blok.intro|nl2br }}</p>{% endif %}
  <div class="mt-8 border-t border-rand">
    {%- for item in blok.accordeonItems.all() %}
      <details class="border-b border-rand">
        <summary class="flex cursor-pointer items-center justify-between gap-6 py-5 text-lg font-semibold text-primair hover:text-accent-donker">
          <span>{{ item.title }}</span>
          <span class="accordeon__icoon shrink-0 transition-transform">{% include '_components/icons/chevron-omlaag' only %}</span>
        </summary>
        {{ m.rich(item.tekst, 'pb-6 text-tekst-zacht') }}
      </details>
    {%- endfor %}
  </div>
</section>

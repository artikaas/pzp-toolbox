{#- Uitgelichte artikelen: de gekozen artikelen, of de drie nieuwste. -#}
{%- import '_components/macros' as m -%}
{%- set artikelen = blok.artikelSelectie.all() -%}
{%- set artikelen = artikelen is empty ? craft.entries().section('artikelen').orderBy('postDate DESC').limit(3).all() : artikelen -%}
{%- if artikelen is not empty -%}
<section class="container-site" {% if blok.kop %}aria-labelledby="blok-{{ blok.id }}"{% endif %}>
  <div class="mb-10 flex flex-col gap-4 md:flex-row md:items-end md:justify-between" data-reveal>
    {%- if blok.kop %}<h2 id="blok-{{ blok.id }}" class="max-w-3xl text-h2 text-primair">{{ m.accent(blok.kop) }}</h2>{% endif %}
    {%- if blok.linkDoel and blok.linkDoel.url %}{% include '_components/link' with { link: blok.linkDoel, stijl: 'tekst', class: 'text-primair' } only %}{% endif %}
  </div>
  <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {%- for artikel in artikelen %}<li data-reveal>{% include '_components/artikel-kaart' with { artikel: artikel } only %}</li>{% endfor %}
  </ul>
</section>
{%- endif -%}

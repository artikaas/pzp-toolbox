{#-
  Rendert het Matrix-veld Blokken. Elk bloktype heeft een eigen template in _blokken/<handle>.twig.
  context: 'home', 'pagina' of 'artikel' (blokken kunnen daarop hun breedte of opmaak aanpassen).
  De ruimte tussen blokken komt van de wrapper (.blokken in src/css/app.css), niet van het blok.
  Blokken met een gekleurde achtergrond krijgen 'blok--vlak', zodat ze aansluiten op elkaar en op de rand.
-#}
{%- for blok in blokken -%}
  {%- set vlak = (blok.achtergrond.value ?? 'wit') not in ['wit', '', null] -%}
  <div class="blok blok--{{ blok.type.handle }}{{ vlak ? ' blok--vlak' }}">
    {%- include ['_blokken/' ~ blok.type.handle, '_blokken/_onbekend'] with { blok: blok, entry: entry, context: context, index: loop.index } only -%}
  </div>
{%- endfor -%}

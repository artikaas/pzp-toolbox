{#-
  Video: YouTube- of Vimeo-link (laadt pas na een klik, zonder cookies vooraf) of een eigen videobestand.
  Het stilstaande beeld is de poster; zonder beeld een neutraal vlak.
-#}
{%- set url = blok.videoLink.url ?? '' -%}
{%- set still = blok.videoStill.one() -%}
{%- set bestand = blok.video.one() -%}
{%- set embed = null -%}
{%- if 'youtu' in url -%}
  {%- set id = 'youtu.be/' in url ? url|split('youtu.be/')|last : ('v=' in url ? url|split('v=')|last : url|split('/')|last) -%}
  {%- set id = id|split('?')|first|split('&')|first -%}
  {%- set embed = 'https://www.youtube-nocookie.com/embed/' ~ id ~ '?autoplay=1&rel=0' -%}
{%- elseif 'vimeo.com' in url -%}
  {%- set pad = url|split('vimeo.com/')|last|split('?')|first|split('/') -%}
  {#- Niet-openbare video's hebben een hash als tweede deel: vimeo.com/123/abcdef -#}
  {%- set hash = (pad[1] ?? '') matches '/^[0-9a-f]+$/' ? '&h=' ~ pad[1] : '' -%}
  {%- set embed = 'https://player.vimeo.com/video/' ~ pad[0] ~ '?autoplay=1&dnt=1' ~ hash -%}
{%- endif -%}
<figure class="{{ context == 'artikel' ? 'mx-auto w-full max-w-[64rem] px-4 md:px-6' : 'container-site' }}" data-reveal>
  <div class="relative aspect-video overflow-hidden rounded-kaart bg-primair-donker">
    {%- if embed %}
      <button type="button" class="group absolute inset-0 flex items-center justify-center" data-video-embed="{{ embed }}" data-video-titel="{{ blok.onderschrift ?: 'Video' }}">
        {% include '_components/image' with { image: still, alt: '', sizes: '(min-width: 1280px) 1280px, 100vw', placeholder: 'none' } only %}
        <span class="relative inline-flex size-20 items-center justify-center rounded-full bg-accent text-primair-donker shadow-lg transition-transform group-hover:scale-105">{% include '_components/icons/play' with { class: 'size-8 translate-x-0.5' } only %}</span>
        <span class="sr-only">Video afspelen{{ blok.onderschrift ? ': ' ~ blok.onderschrift }}</span>
      </button>
    {%- elseif bestand %}
      <video class="absolute inset-0 h-full w-full" controls preload="none" playsinline{% if still %} poster="{{ still.getUrl({ width: 1920, format: 'jpg' }) }}"{% endif %}>
        <source src="{{ bestand.url }}" type="{{ bestand.mimeType ?? 'video/mp4' }}">
      </video>
    {%- else %}
      <p class="absolute inset-0 flex items-center justify-center p-6 text-center text-klein text-wit/70">Nog geen video gekoppeld</p>
    {%- endif %}
  </div>
  {%- if blok.onderschrift %}<figcaption class="mt-3 text-klein text-tekst-zacht">{{ blok.onderschrift }}</figcaption>{% endif %}
</figure>

# Omgeving
CRAFT_APP_ID=pzp-toolbox
CRAFT_ENVIRONMENT=dev
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=true
CRAFT_ALLOW_ADMIN_CHANGES=true
CRAFT_DISALLOW_ROBOTS=true

# Database (DDEV-standaard)
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=db
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=db
CRAFT_DB_USER=db
CRAFT_DB_PASSWORD=db
CRAFT_DB_SCHEMA=public
CRAFT_DB_TABLE_PREFIX=

# Site
PRIMARY_SITE_URL=https://pzp-toolbox.ddev.site

# Contactformulier: ontvanger als de global 'Contact' leeg is
CONTACT_FORM_TO=info@voorbeeld.nl
